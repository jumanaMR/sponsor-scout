# --- Personal data: never commit -------------------------------------------
# Your CV and any real job postings you collect are personal data. The
# template in data/ is committed; anything you actually fill in is not.
my_cv.*
cv.*
*_cv.pdf
*_cv.docx
data/*.csv
!data/sponsor_leads_template.csv
seen_postings.json
sponsorship_report.csv

